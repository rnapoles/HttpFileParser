{
  "info": {
    "name": "sample",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "loginRequest",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{contentType}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"otpCode\": \"{{otpCode}}\",\n  \"deviceName\": \"REST Client\",\n  \"tokenDelivery\": \"body\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{apiUrl}}/auth/login"
        }
      }
    },
    {
      "name": "loginCookie",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{contentType}}",
            "type": "text"
          },
          {
            "key": "Origin",
            "value": "{{publicOrigin}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"otpCode\": \"{{otpCode}}\",\n  \"deviceName\": \"REST Client (cookies)\",\n  \"tokenDelivery\": \"cookie\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{apiUrl}}/auth/login"
        }
      }
    },
    {
      "name": "hello",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://{{apiUrl}}/authors/{{name}}"
        }
      }
    },
    {
      "name": "PostXmlFile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/xml",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "token xxx",
            "type": "text"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": "C:\\Users\\Default\\Desktop\\demo.xml"
          }
        },
        "url": {
          "raw": "https://example.com/comments"
        }
      }
    },
    {
      "name": "SampleWithFunctions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/xml",
            "type": "text"
          },
          {
            "key": "Date",
            "value": "{{$datetime rfc1123}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_name\": \"{{$dotenv 'USERNAME'}}\",\n    \"request_id\": \"{{$guid}}\",\n    \"updated_at\": \"{{$timestamp}}\",\n    \"created_at\": \"{{$timestamp -1 d}}\",\n    \"review_count\": \"{{$randomInt}}\",\n    \"custom_date\": \"{{$datetime 'YYYY-MM-DD'}}\",\n    \"local_custom_date\": \"{{$localDatetime 'YYYY-MM-DD'}}\"\n}",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "https://api.example.com/comments"
        }
      }
    }
  ]
}
