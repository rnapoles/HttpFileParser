@baseUrl = http://localhost:8443
@apiUrl = {{baseUrl}}/api/v1

@authToken = {{$jsonpath 'loginRequest.response.body.$.payload.accessToken'}}
@refreshToken = {{$jsonpath 'loginRequest.response.body.$.payload.refreshToken'}}
@sessionId = {{$jsonpath 'loginRequest.response.body.$.payload.sessionId'}}
@csrfToken = {{$jsonpath 'loginCookie.response.body.$.payload.csrfToken'}}

@userId = {{$jsonpath 'createUser.response.body.$.payload.id'}}
@certificateId = {{$jsonpath 'createCertificate.response.body.$.payload.id'}}
@eventId = {{$jsonpath 'listAuditEvents.response.body.$.payload.items[0].id'}}

@publicOrigin = https://localhost:8443
@contentType = application/json
@mergePatch = application/merge-patch+json

@login = root
@password = +/Itu+II7VQLni8Z
@otpCode = 437499

### Login, tokens in the response body (scripts and services).
# @name loginRequest
POST {{apiUrl}}/auth/login
Content-Type: {{contentType}}

{
  "login": "{{login}}",
  "password": "{{password}}",
  "otpCode": "{{otpCode}}",
  "deviceName": "REST Client",
  "tokenDelivery": "body"
}

### Login, tokens as HttpOnly cookies plus a CSRF token in the body (browser style, the default).
# The Origin header is required for cookie sessions. REST Client keeps the cookies for later requests.
# @name loginCookie
POST {{apiUrl}}/auth/login
Content-Type: {{contentType}}
Origin: {{publicOrigin}}

{
  "login": "{{login}}",
  "password": "{{password}}",
  "otpCode": "{{otpCode}}",
  "deviceName": "REST Client (cookies)",
  "tokenDelivery": "cookie"
}

# @name = hello
GET https://{{host}}/authors/{{name}} HTTP/1.1

# @name PostXmlFile
POST https://example.com/comments HTTP/1.1
Content-Type: application/xml
Authorization: token xxx

< C:\Users\Default\Desktop\demo.xml # Only is valid here

# @name SampleWithFunctions
POST https://api.example.com/comments HTTP/1.1
Content-Type: application/xml
Date: {{$datetime rfc1123}}

{
    "user_name": "{{$dotenv 'USERNAME'}}",
    "request_id": "{{$guid}}",
    "updated_at": "{{$timestamp}}",
    "created_at": "{{$timestamp -1 d}}",
    "review_count": "{{$randomInt 5 200}}",
    "custom_date": "{{$datetime 'YYYY-MM-DD'}}",
    "local_custom_date": "{{$localDatetime 'YYYY-MM-DD'}}"
}